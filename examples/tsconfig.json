{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": "..",
    "types": ["node", "@cloudflare/workers-types"],
    "paths": {
      "@armature-tech/ai-traffic": ["./src/index.ts"],
      "@armature-tech/ai-traffic/*": ["./src/*.ts"]
    }
  },
  "include": ["./*.ts", "../src/**/*.ts"],
  "exclude": ["./types.d.ts"]
}
